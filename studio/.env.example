# From sanity.io/manage after you create the project
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Only needed to run `npm run seed` (Editor token, sanity.io/manage → API → Tokens)
SANITY_WRITE_TOKEN=

# Optional: the <name>.sanity.studio hostname for `npm run deploy`
SANITY_STUDIO_HOSTNAME=
