# Content from the CAOIM admin (optional).
# Without these, the site shows the built-in content in src/content/site.js.
# Both come from the admin's Supabase project → Project Settings → API Keys.
# The publishable key is safe to expose: it can only read published website content.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
